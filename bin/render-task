#!/usr/bin/env python3
"""Generate deterministic task parameters from a task pack and seed."""
import hashlib
import json
import pathlib
import subprocess
import sys

import yaml

if len(sys.argv) != 4:
    raise SystemExit(f"usage: {sys.argv[0]} PACK_DIR SEED OUTPUT_JSON")
pack = pathlib.Path(sys.argv[1]).resolve()
seed = sys.argv[2]
output = pathlib.Path(sys.argv[3])
meta = yaml.safe_load((pack / "meta.yaml").read_text())
generator = pack / "generate_params.py"
result = subprocess.run([str(generator), seed], check=True, text=True, capture_output=True)
params = json.loads(result.stdout)
payload = {
    "task_id": meta["id"],
    "seed": seed,
    "derivation": hashlib.sha256(f"{meta['id']}:{seed}".encode()).hexdigest(),
    "params": params,
}
output.write_text(json.dumps(payload, sort_keys=True, indent=2) + "\n")
