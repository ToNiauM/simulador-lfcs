#!/usr/bin/env python3
"""Create optional feedback from an objective checker result."""
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
from lfcs_simulator.llm import generate

if len(sys.argv) != 4:
    raise SystemExit(f"usage: {sys.argv[0]} CHECK_RESULT_JSON INSTRUCTIONS_MD MODEL")
result = json.loads(pathlib.Path(sys.argv[1]).read_text())
instructions = pathlib.Path(sys.argv[2]).read_text()
messages = [
    {"role": "system", "content": "Você é um tutor LFCS. Explique lacunas objetivas sem inventar comandos executados. A nota oficial é imutável."},
    {"role": "user", "content": f"Enunciado:\n{instructions}\n\nResultado objetivo:\n{json.dumps(result, ensure_ascii=False)}\n\nDê feedback conciso em português."},
]
completion = generate(messages, sys.argv[3])
print(json.dumps({"provider": completion.provider, "model": completion.model, "feedback": completion.text}, ensure_ascii=False))
