{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LFCS checker result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "result", "score", "max_score", "criteria"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "error"]},
    "score": {"type": "integer", "minimum": 0},
    "max_score": {"type": "integer", "minimum": 1},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "result", "points", "max_points", "message", "evidence"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "result": {"enum": ["pass", "fail", "error"]}, "points": {"type": "integer", "minimum": 0}, "max_points": {"type": "integer", "minimum": 1}, "message": {"type": "string"}, "evidence": {"type": "string"}}}}
  }
}
